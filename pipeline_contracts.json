{
  "version": "1.0",
  "runtime": {
    "python": "env/bin/python",
    "notebook_source_dir": "notebooks/src",
    "logs_dir": "reports/logs",
    "summaries_dir": "reports/summaries",
    "execution_policy": ".github/skills/notebook-execution.md"
  },
  "excluded_columns": {
    "pii": [
      "CUST_NO",
      "CUST_TRAN_DATE",
      "PERIOD_ORDER",
      "BUSINESS_LINE",
      "PARTITION_KEY",
      "CUST_TARGET_F"
    ],
    "bad_features": [
      "FOLLOW_CODE_L3M"
    ],
    "leakage": [],
    "leakage_reviewed": []
  },
  "temporal_split": {
    "period_column": "DONEM",
    "test_periods": [
      "202603",
      "202604",
      "202605"
    ],
    "val_periods": [
      "202512",
      "202601",
      "202602"
    ]
  },
  "execution_order": [
    "feature_type_declaration",
    "preprocess",
    "feature_selection",
    "model_trainer"
  ],
  "stages": {
    "feature_type_declaration": {
      "agent": ".github/agents/FeatureTypeDeclaration.agent.md",
      "inputs": {
        "sql_server": "DUMMY-SQL-SRV01",
        "sql_database": "DummyDatabase",
        "sql_table": "dbo.dummy_table",
        "target_column": "TARGET_F"
      },
      "outputs": {
        "raw_data": "data/data.parquet",
        "feature_types": "reports/feature_types.csv",
        "high_corr_pairs": "reports/high_corr_pairs.csv",
        "notebook": "notebooks/01_feature_type_declaration.ipynb",
        "summary": "reports/summaries/feature_type_declaration_summary.json",
        "data_audit": "reports/data_audit.csv",
        "leakage_audit": "reports/leakage_audit.csv"
      },
      "validation": [
        "data/data.parquet exists",
        "reports/feature_types.csv exists",
        "reports/data_audit.csv and reports/leakage_audit.csv exist",
        "notebooks/01_feature_type_declaration.ipynb executed with errors=0",
        "reports/summaries/feature_type_declaration_summary.json exists"
      ]
    },
    "preprocess": {
      "agent": ".github/agents/Preprocess.agent.md",
      "depends_on": [
        "feature_type_declaration"
      ],
      "inputs": {
        "feature_types": "reports/feature_types.csv",
        "raw_data": "data/data.parquet",
        "target_column": "TARGET_F"
      },
      "outputs": {
        "processed_splits": "data/processed/{MODEL_TYPE}_{split}.parquet",
        "null_cleaning_report": "reports/null_cleaning_report.csv",
        "imputation_strategy": "reports/imputation_strategy.csv",
        "benchmark_results": "reports/benchmark_results.csv",
        "pipeline_config": "reports/pipeline_config.json",
        "notebook": "notebooks/02_preprocess.ipynb",
        "summary": "reports/summaries/preprocess_summary.json",
        "processed_oot": "data/out_of_time/oot_raw.parquet",
        "val_eval_plan": "data/processed/_val_eval_idx.parquet",
        "data_profile": "reports/data_profile.json"
      },
      "validation": [
        "reports/benchmark_results.csv exists",
        "reports/pipeline_config.json exists",
        "pipeline_config.approval_confirmed == true (set by the user in chat, never inside the notebook)",
        "notebooks/02_preprocess.ipynb executed with errors=0",
        "reports/summaries/preprocess_summary.json exists",
        "pipeline_config.MODEL_TYPE in [catboost, lightgbm, xgboost] before next stage",
        "data/out_of_time/oot_raw.parquet exists",
        "data/processed/_val_eval_idx.parquet exists"
      ]
    },
    "feature_selection": {
      "agent": ".github/agents/FeatureSelection.agent.md",
      "depends_on": [
        "preprocess"
      ],
      "inputs": {
        "pipeline_config": "reports/pipeline_config.json",
        "feature_types": "reports/feature_types.csv",
        "processed_train": "data/processed/{MODEL_TYPE}_train.parquet",
        "processed_val": "data/processed/{MODEL_TYPE}_val.parquet",
        "val_eval_plan": "data/processed/_val_eval_idx.parquet"
      },
      "outputs": {
        "feature_importance": "reports/checkpoints/fi_df.csv",
        "selection_log": "reports/feature_selection_log.csv",
        "selected_features": "reports/selected_features.csv",
        "selection_auc_summary": "reports/selection_auc_summary.csv",
        "notebook": "notebooks/03_feature_selection.ipynb",
        "summary": "reports/summaries/feature_selection_summary.json",
        "challenger_check": "reports/selection_challenger_check.csv"
      },
      "validation": [
        "reports/selected_features.csv exists",
        "reports/selection_auc_summary.csv exists",
        "notebooks/03_feature_selection.ipynb executed with errors=0",
        "reports/summaries/feature_selection_summary.json exists"
      ]
    },
    "model_trainer": {
      "agent": ".github/agents/ModelTrainer.agent.md",
      "depends_on": [
        "feature_selection"
      ],
      "inputs": {
        "pipeline_config": "reports/pipeline_config.json",
        "feature_types": "reports/feature_types.csv",
        "selected_features": "reports/selected_features.csv",
        "processed_train": "data/processed/{MODEL_TYPE}_train.parquet",
        "processed_val": "data/processed/{MODEL_TYPE}_val.parquet",
        "raw_data": "data/data.parquet"
      },
      "outputs": {
        "baseline_auc": "reports/baseline_auc.csv",
        "best_params": "reports/best_params.json",
        "search_space": "reports/search_space.json",
        "oof_predictions": "reports/oof_predictions.parquet",
        "calibration": "reports/calibration.json",
        "calibrator": "models/{MODEL_TYPE}_calibrator.pkl (only if applied)",
        "training_notebook": "notebooks/04_model_training.ipynb",
        "summary": "reports/summaries/model_trainer_summary.json",
        "pipeline": "models/{MODEL_TYPE}_pipeline_final.pkl",
        "final_model": "models/{MODEL_TYPE}_final.{cbm|txt|json}",
        "freeze_manifest": "models/freeze_manifest.json",
        "final_metrics": "reports/final_model_metrics.json",
        "decile_table": "reports/decile_table.csv",
        "lift_table": "reports/lift_table.csv",
        "lift_curve": "reports/figures/lift_curve.png",
        "oot_topk": "reports/oot_topk.csv",
        "oot_monthly": "reports/oot_monthly.csv",
        "calibration_curve": "reports/figures/calibration_curve.png",
        "deployment_gate": "reports/deployment_gate.json",
        "pipeline_notebook": "notebooks/pipeline.ipynb",
        "pipeline_summary": "reports/summaries/pipeline_summary.json"
      },
      "validation": [
        "reports/best_params.json and reports/calibration.json exist",
        "notebooks/04_model_training.ipynb executed with errors=0",
        "models/{MODEL_TYPE}_pipeline_final.pkl and models/freeze_manifest.json exist",
        "reports/deployment_gate.json exists with decision in [PASS, REVIEW REQUIRED, BLOCKED]",
        "notebooks/pipeline.ipynb executed with errors=0",
        "reports/summaries/model_trainer_summary.json and reports/summaries/pipeline_summary.json exist"
      ]
    }
  },
  "audit": {
    "key_columns": [
      "CUST_NO",
      "DONEM"
    ],
    "single_feature_auc_max": 0.9,
    "event_rate_z": 3.0,
    "null_rate_jump": 0.3
  },
  "preprocessing": {
    "impute_numeric": {
      "catboost": null,
      "lightgbm": null,
      "xgboost": null
    }
  },
  "validation_eval": {
    "max_rows_per_period": 200000,
    "min_pos_per_period": 10,
    "bootstrap_n": 1000
  },
  "model_training": {
    "overrides": {}
  },
  "optuna": {
    "storage": "sqlite:///reports/optuna_study.db",
    "n_trials": 50,
    "timeout_sec": 3600
  },
  "deployment_gate": {
    "min_test_auc": 0.7,
    "min_test_auc_ci_low": 0.68,
    "warn_val_test_auc_drop": 0.03,
    "fail_val_test_auc_drop": 0.06,
    "warn_worst_month_auc": 0.65,
    "warn_abs_calibration_in_large": 0.2,
    "fail_abs_calibration_in_large": 0.5
  }
}
